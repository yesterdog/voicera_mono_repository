# Asterisk ARI connection (container DNS name on voicera_poc_net)
BRIDGE_ASTERISK_HOST=asterisk
BRIDGE_ASTERISK_PORT=8088
BRIDGE_ASTERISK_SCHEME=http
BRIDGE_ARI_USERNAME=asterisk
BRIDGE_ARI_PASSWORD=asterisk
BRIDGE_STASIS_APP=voicera-poc

# RTP: bind on all interfaces inside the bridge container; advertise host is
# auto-detected (this container's own IP) if left unset.
BRIDGE_RTP_HOST=0.0.0.0
BRIDGE_RTP_PORT=20000
BRIDGE_RTP_PORT_RANGE_END=20020

# Voicera voice_2_voice_server: reached directly by container name, since
# the bridge now joins voice_server's own `voicera_network` (both live in
# this repo's docker-compose setup).
# apps/runtime (compose project voicera_oss), reachable because the runtime is
# attached to voicera_poc_net via docker-compose.local.yaml at the repo root.
VOICERA_WS_URL=ws://voicera_oss_runtime:7860

# Fill in after creating the demo agent (see asterisk_poc/README.md)
# apps/api agent id ("Asterisk POC Agent", org 04f9d4). The runtime route is
# org-scoped, so the path is given explicitly rather than derived from the id.
VOICERA_AGENT_ID=a1fe6558-2d8c-4e04-82bc-c1355f407b57
VOICERA_WS_PATH=/agent/04f9d4/a1fe6558-2d8c-4e04-82bc-c1355f407b57
