# Template. Real values go in .env.jambonz (gitignored).
# Regenerate with:  bash ./generate-config.sh

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# --- Jambonz internal ---
DRACHTIO_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_SECRET=CHANGE_ME

# --- Softphone SIP creds (Zoiper will use these) ---
SOFTPHONE_SIP_PASSWORD=softphone
# Realm must be a hostname string (jambonz rejects raw IPv4 realms).
# Any FQDN-looking string works — Zoiper's outbound proxy is what actually
# routes traffic (points at 129.121.140.95:5062).
SOFTPHONE_REALM=voicera-jambonz.local

# --- rtpengine LOCAL_IP ---
# Placeholder — filled after first `up` when we know what IP docker assigned
# to the jambonz_rtpengine container on voicera_network. See generate-config.sh
# and the compose file's rtpengine service for the fix procedure.
RTPENGINE_LOCAL_IP=172.18.0.99
